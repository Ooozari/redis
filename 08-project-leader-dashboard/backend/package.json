{
  "name": "redis-leaderboard-dashboard-backend",
  "version": "1.0.0",
  "description": "Backend API for a real-time leaderboard dashboard built with Node.js, TypeScript, Express, Redis, MongoDB, and Socket.IO.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js"
  },
  "keywords": [
    "redis",
    "leaderboard",
    "real-time",
    "typescript",
    "nodejs",
    "express",
    "mongodb",
    "mongoose",
    "socket.io",
    "websocket",
    "backend",
    "api",
    "ioredis"
  ],
  "author": "ooozari - Uzair Asif",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "mongoose": "^9.9.1",
    "node-cron": "^4.6.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2"
  }
}
